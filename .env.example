# ---------------------------------------------------------------------------
# Database (matches docker-compose.yml)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://careshield:careshield@localhost:5432/careshield

# ---------------------------------------------------------------------------
# API (NestJS)
# ---------------------------------------------------------------------------
API_PORT=3001
NODE_ENV=development

# How long a quote stays locked. Lower this to demo the expiry gate quickly.
QUOTE_TTL_MINUTES=15

# Shared secret the Next.js server sends as `x-service-token`. The browser
# never sees this — only the Next.js server-side runtime does.
SERVICE_TOKEN=dev-service-token-change-me

# Artificial latency (ms) for the mock payment provider. Makes the
# double-click and idempotency races reproducible by hand.
MOCK_PAYMENT_LATENCY_MS=1200

# ---------------------------------------------------------------------------
# Web (Next.js) — server-only, never exposed to the client bundle
# ---------------------------------------------------------------------------
API_BASE_URL=http://localhost:3001
WEB_PORT=3000
